---
import { personalInfo, stats, socialLinks } from '../data/portfolio';

const highlights = [
  { icon: '🚀', title: 'Performa Tinggi', desc: 'Arsitektur modern yang ringan dan cepat dimuat.' },
  { icon: '🎨', title: 'Desain Berkelas', desc: 'Antarmuka intuitif dengan standar estetika tinggi.' },
  { icon: '🔒', title: 'Clean & Scalable', desc: 'Struktur kode rapi, modular, dan mudah di-maintain.' },
  { icon: '💡', title: 'Problem Solver', desc: 'Cepat beradaptasi dan menemukan solusi efektif.' }
];
---

<section id="about" class="about-section">
  <div class="container">
    <!-- Section Header -->
    <div class="section-header">
      <span class="section-tag">
        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        Tentang Saya
      </span>
      <h2 class="section-title">
        Mendedikasikan Passion untuk <span class="gradient-text">Kualitas & Inovasi</span>
      </h2>
      <p class="section-subtitle">
        Sekilas tentang filosofi kerja, keahlian, dan apa yang mendorong saya menciptakan produk digital terbaik.
      </p>
    </div>

    <!-- Main About Grid -->
    <div class="about-grid">
      <!-- Left Card: Bio & Core Philosophy -->
      <div class="glass-card about-bio-card">
        <div class="bio-header">
          <div class="bio-location-badge">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>{personalInfo.location}</span>
          </div>
          <span class="bio-status-badge">Tersedia untuk Kerja Sama</span>
        </div>

        <div class="bio-paragraphs">
          {personalInfo.detailedAbout.map((para) => (
            <p>{para}</p>
          ))}
        </div>

        <!-- Highlight Grid -->
        <div class="highlights-grid">
          {highlights.map((item) => (
            <div class="highlight-item">
              <span class="highlight-icon">{item.icon}</span>
              <div class="highlight-text">
                <h4>{item.title}</h4>
                <p>{item.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Quick Action Bar -->
        <div class="about-actions">
          <a href={personalInfo.resumeUrl} class="btn btn-secondary">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span>Unduh CV Lengkap</span>
          </a>

          <button id="about-copy-email" class="btn btn-secondary" data-email={socialLinks.email}>
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span>Salin Email Saya</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Interactive Stats Cards -->
      <div class="stats-column">
        {stats.map((stat, idx) => (
          <div class="glass-card stat-card" style={`animation-delay: ${idx * 0.1}s;`}>
            <div class="stat-number-wrapper">
              <span class="stat-number">{stat.number}</span>
              <div class="stat-glow"></div>
            </div>
            <h3 class="stat-label">{stat.label}</h3>
            <p class="stat-sublabel">{stat.sublabel}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('about-copy-email');
  copyBtn?.addEventListener('click', () => {
    const email = copyBtn.getAttribute('data-email');
    if (email) {
      navigator.clipboard.writeText(email).then(() => {
        // @ts-ignore
        if (typeof window.showToast === 'function') {
          // @ts-ignore
          window.showToast(`Email (${email}) berhasil disalin ke clipboard!`, 'success');
        }
      });
    }
  });
</script>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 2rem;
    align-items: stretch;
  }

  /* Left Bio Card */
  .about-bio-card {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .bio-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .bio-location-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--accent-cyan-light);
    font-weight: 500;
  }

  .bio-status-badge {
    font-size: 0.8rem;
    font-weight: 600;
    color: #34d399;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 0.25rem 0.85rem;
    border-radius: var(--radius-full);
  }

  .bio-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.75;
  }

  /* Highlights */
  .highlights-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    background: rgba(255, 255, 255, 0.02);
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .highlight-icon {
    font-size: 1.4rem;
    line-height: 1;
  }

  .highlight-text h4 {
    font-size: 0.95rem;
    margin-bottom: 0.2rem;
    color: var(--text-primary);
  }

  .highlight-text p {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  /* Right Stats Column */
  .stats-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .stat-card {
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .stat-number-wrapper {
    position: relative;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 800;
    line-height: 1;
    background: var(--text-neon);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .stat-glow {
    position: absolute;
    inset: -10px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.3) 0%, transparent 70%);
    filter: blur(15px);
    z-index: -1;
    opacity: 0.7;
  }

  .stat-label {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    color: var(--text-primary);
  }

  .stat-sublabel {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.35;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .highlights-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 540px) {
    .stats-column {
      grid-template-columns: 1fr;
    }

    .about-bio-card {
      padding: 1.5rem;
    }
  }
</style>
