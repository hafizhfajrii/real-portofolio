---
import { personalInfo, socialLinks } from '../data/portfolio';
---

<section id="hero" class="hero-section">
  <div class="container hero-container">
    <!-- Left Column: Intro & Call-to-Actions -->
    <div class="hero-content">
      <!-- Status Badge -->
      <div class="status-wrapper">
        <span class="status-badge">
          <span class="status-dot"></span>
          <span>{personalInfo.status.text}</span>
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="hero-title">
        Hai, Saya <span class="gradient-text">{personalInfo.name}</span> 👋
      </h1>

      <!-- Dynamic Typing Subtitle -->
      <div class="role-typewriter-container">
        <span class="role-prefix">Seorang </span>
        <span id="typewriter-text" class="typewriter-text" data-roles={JSON.stringify(personalInfo.typingRoles)}>
          {personalInfo.role}
        </span>
        <span class="typewriter-cursor">|</span>
      </div>

      <!-- Tagline / Bio excerpt -->
      <p class="hero-tagline">
        {personalInfo.tagline}
      </p>

      <!-- Action Buttons (CTA) -->
      <div class="hero-actions">
        <a href="#projects" class="btn btn-primary">
          <span>Lihat Proyek Saya</span>
          <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a href="#contact" class="btn btn-secondary">
          <span>Hubungi Saya</span>
          <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
        </a>
      </div>

      <!-- Quick Social Media Bar -->
      <div class="hero-socials">
        <span class="socials-label">Koneksi Cepat:</span>
        <div class="socials-icons">
          <!-- LinkedIn -->
          <a href={socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="Profil LinkedIn">
            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>

          <!-- GitHub -->
          <a href={socialLinks.github} target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="Profil GitHub">
            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
          </a>

          <!-- Instagram -->
          <a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="Profil Instagram">
            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>

          <!-- Email Copy / Mailto -->
          <button id="hero-copy-email-btn" class="btn-icon" aria-label="Salin Email" data-email={socialLinks.email} title="Salin Email">
            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </button>

          <!-- WhatsApp -->
          <a href={socialLinks.whatsapp} target="_blank" rel="noopener noreferrer" class="btn-icon" aria-label="Hubungi via WhatsApp">
            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: Avatar with Neon Glass Halo Frame -->
    <div class="hero-visual">
      <div class="avatar-halo-wrapper">
        <!-- Floating Ambient Glow Rings -->
        <div class="halo-ring ring-outer"></div>
        <div class="halo-ring ring-middle"></div>

        <!-- Glass Avatar Card Container -->
        <div class="avatar-card">
          <div class="avatar-image-container">
            <img 
              src={personalInfo.avatarUrl} 
              alt={personalInfo.name} 
              class="avatar-photo"
              loading="eager"
            />
            <div class="avatar-overlay"></div>
          </div>

          <!-- Floating Badges -->
          <div class="floating-pill pill-top-right">
            <span class="pill-icon">✨</span>
            <span class="pill-text">Clean Code & UI</span>
          </div>

          <div class="floating-pill pill-bottom-left">
            <span class="pill-icon">⚡</span>
            <span class="pill-text">100% Performance</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Typewriter dynamic text animation
  const textEl = document.getElementById('typewriter-text');
  if (textEl) {
    const roles: string[] = JSON.parse(textEl.getAttribute('data-roles') || '[]');
    let roleIdx = 0;
    let charIdx = 0;
    let isDeleting = false;
    let typingSpeed = 100;

    function type() {
      if (!roles.length) return;
      const currentRole = roles[roleIdx];

      if (isDeleting) {
        textEl.textContent = currentRole.substring(0, charIdx - 1);
        charIdx--;
        typingSpeed = 50;
      } else {
        textEl.textContent = currentRole.substring(0, charIdx + 1);
        charIdx++;
        typingSpeed = 100;
      }

      if (!isDeleting && charIdx === currentRole.length) {
        isDeleting = true;
        typingSpeed = 2000; // Pause at end of word
      } else if (isDeleting && charIdx === 0) {
        isDeleting = false;
        roleIdx = (roleIdx + 1) % roles.length;
        typingSpeed = 400; // Pause before new word
      }

      setTimeout(type, typingSpeed);
    }

    setTimeout(type, 800);
  }

  // Copy Email Button Listener
  const copyBtn = document.getElementById('hero-copy-email-btn');
  copyBtn?.addEventListener('click', () => {
    const email = copyBtn.getAttribute('data-email');
    if (email) {
      navigator.clipboard.writeText(email).then(() => {
        // @ts-ignore
        if (typeof window.showToast === 'function') {
          // @ts-ignore
          window.showToast(`Email (${email}) berhasil disalin ke clipboard!`, 'success');
        }
      });
    }
  });
</script>

<style>
  .hero-section {
    min-height: calc(100vh - 80px);
    display: flex;
    align-items: center;
    padding-top: 8rem;
    padding-bottom: 5rem;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3.5rem;
    align-items: center;
  }

  /* Left Hero Content */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .status-wrapper {
    margin-bottom: 0.25rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 3.8rem);
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  /* Role Typewriter */
  .role-typewriter-container {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    min-height: 2.2rem;
  }

  .typewriter-text {
    color: var(--accent-cyan-light);
    font-weight: 700;
    text-shadow: 0 0 20px rgba(6, 182, 212, 0.4);
  }

  .typewriter-cursor {
    color: var(--accent-indigo-light);
    font-weight: 300;
    animation: blinkCursor 0.8s infinite;
  }

  @keyframes blinkCursor {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .hero-tagline {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 540px;
    margin-top: 0.25rem;
  }

  /* Action Buttons */
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  /* Social Links */
  .hero-socials {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .socials-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .socials-icons {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* Right Visual - Avatar Halo */
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  .avatar-halo-wrapper {
    position: relative;
    width: 360px;
    height: 360px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .halo-ring {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .ring-outer {
    inset: -20px;
    border: 2px dashed rgba(6, 182, 212, 0.25);
    animation: rotateClockwise 30s linear infinite;
  }

  .ring-middle {
    inset: -6px;
    background: var(--gradient-neon);
    filter: blur(14px);
    opacity: 0.6;
    animation: pulseRing 4s ease-in-out infinite alternate;
  }

  @keyframes rotateClockwise {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes pulseRing {
    0% { transform: scale(0.96); opacity: 0.4; }
    100% { transform: scale(1.04); opacity: 0.8; }
  }

  /* Avatar Card */
  .avatar-card {
    position: relative;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    padding: 6px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.02));
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-glass);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    z-index: 2;
  }

  .avatar-image-container {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    position: relative;
    background: #0b1120;
  }

  .avatar-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .avatar-card:hover .avatar-photo {
    transform: scale(1.06);
  }

  .avatar-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(6, 9, 19, 0.3) 0%, transparent 60%);
    pointer-events: none;
  }

  /* Floating Pills */
  .floating-pill {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(16px);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-full);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
    animation: floatGentle 5s ease-in-out infinite;
    z-index: 3;
  }

  .pill-top-right {
    top: 15px;
    right: -30px;
    animation-delay: -1s;
    border-color: rgba(168, 85, 247, 0.4);
  }

  .pill-bottom-left {
    bottom: 15px;
    left: -30px;
    animation-delay: -3.5s;
    border-color: rgba(6, 182, 212, 0.4);
  }

  .pill-icon {
    font-size: 1rem;
  }

  /* Responsive */
  @media (max-width: 992px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 3rem;
    }

    .hero-content {
      align-items: center;
    }

    .role-typewriter-container {
      justify-content: center;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-socials {
      justify-content: center;
    }

    .hero-visual {
      order: -1;
    }

    .avatar-halo-wrapper {
      width: 280px;
      height: 280px;
    }

    .avatar-card {
      width: 250px;
      height: 250px;
    }

    .pill-top-right {
      right: -10px;
    }

    .pill-bottom-left {
      left: -10px;
    }
  }
</style>
