---
import { content, experiencesData, educationData } from '../data/portfolio';
const { experience } = content.id;
const enExp = content.en.experience;
---

<section id="experience" class="experience-section">
  <div class="container">
    <!-- Section Header -->
    <div class="section-header">
      <span class="section-tag" data-i18n-id={experience.sectionTag} data-i18n-en={enExp.sectionTag}>
        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
        </svg>
        {experience.sectionTag}
      </span>
      <h2 class="section-title">
        <span data-i18n-id={experience.title} data-i18n-en={enExp.title}>{experience.title}</span>{' '}
        <span class="gradient-text" data-i18n-id={experience.titleHighlight} data-i18n-en={enExp.titleHighlight}>{experience.titleHighlight}</span>
      </h2>
      <p class="section-subtitle" data-i18n-id={experience.subtitle} data-i18n-en={enExp.subtitle}>
        {experience.subtitle}
      </p>
    </div>

    <div class="experience-layout">
      <!-- Left: Career Timeline -->
      <div class="timeline-column">
        <h3 class="column-title">
          <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="title-icon">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
          </svg>
          <span data-i18n-id={experience.workTitle} data-i18n-en={enExp.workTitle}>{experience.workTitle}</span>
        </h3>

        <div class="timeline-tree">
          {experiencesData.map((exp) => (
            <div class="timeline-item">
              <div class="timeline-dot-wrapper">
                <div class="timeline-dot"></div>
                <div class="timeline-line"></div>
              </div>

              <div class="glass-card timeline-card">
                <div class="timeline-header">
                  <div>
                    <span class="timeline-period">{exp.period}</span>
                    <h4 class="timeline-role">{exp.role}</h4>
                    <span class="timeline-company">{exp.company} • {exp.location}</span>
                  </div>
                  <span class="exp-type-badge">{exp.type}</span>
                </div>

                <ul class="timeline-desc-list">
                  {exp.description.id.map((item, dIdx) => (
                    <li data-i18n-id={item} data-i18n-en={exp.description.en[dIdx]}>
                      {item}
                    </li>
                  ))}
                </ul>

                <div class="timeline-skills">
                  {exp.skills.map((skill) => (
                    <span class="skill-mini-pill">{skill}</span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Education & Certifications -->
      <div class="education-column">
        <h3 class="column-title">
          <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="title-icon">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
          </svg>
          <span data-i18n-id={experience.eduTitle} data-i18n-en={enExp.eduTitle}>{experience.eduTitle}</span>
        </h3>

        <div class="education-list">
          {educationData.map((edu) => (
            <div class="glass-card education-card">
              <span class="timeline-period">{edu.period}</span>
              <h4 class="edu-degree" data-i18n-id={edu.degree.id} data-i18n-en={edu.degree.en}>{edu.degree.id}</h4>
              <h5 class="edu-institution">{edu.institution} • {edu.location}</h5>
              <p class="edu-desc" data-i18n-id={edu.description.id} data-i18n-en={edu.description.en}>{edu.description.id}</p>
            </div>
          ))}

          <!-- Continuous Learning Highlight Card -->
          <div class="glass-card learning-card">
            <div class="learning-header">
              <span class="learning-icon">⚡</span>
              <h4 data-i18n-id={experience.learningTitle} data-i18n-en={enExp.learningTitle}>{experience.learningTitle}</h4>
            </div>
            <p data-i18n-id={experience.learningDesc} data-i18n-en={enExp.learningDesc}>
              {experience.learningDesc}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .experience-layout {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 3rem;
    align-items: flex-start;
  }

  .column-title {
    font-size: 1.35rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 2rem;
    color: var(--text-primary);
  }

  .title-icon {
    color: var(--accent-cyan);
  }

  .timeline-tree {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 24px 1fr;
    gap: 1.5rem;
    position: relative;
  }

  .timeline-dot-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .timeline-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent-cyan);
    border: 3px solid var(--bg-deep);
    box-shadow: 0 0 15px var(--accent-cyan);
    z-index: 2;
    margin-top: 1.5rem;
  }

  .timeline-line {
    width: 2px;
    height: 100%;
    background: linear-gradient(to bottom, var(--border-glass), transparent);
    margin-top: -5px;
  }

  .timeline-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .timeline-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .timeline-period {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-cyan-light);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.25rem;
  }

  .timeline-role {
    font-size: 1.25rem;
    margin-bottom: 0.2rem;
  }

  .timeline-company {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .exp-type-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-indigo-light);
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.3);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
  }

  .timeline-desc-list {
    list-style: square;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .timeline-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
  }

  .skill-mini-pill {
    font-size: 0.78rem;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .education-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .education-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .edu-degree {
    font-size: 1.15rem;
    color: var(--text-primary);
  }

  .edu-institution {
    font-size: 0.88rem;
    color: var(--accent-indigo-light);
    font-weight: 500;
  }

  .edu-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .learning-card {
    padding: 1.75rem;
    background: rgba(99, 102, 241, 0.06);
    border-color: rgba(99, 102, 241, 0.25);
  }

  .learning-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }

  .learning-icon {
    font-size: 1.25rem;
  }

  .learning-card p {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 992px) {
    .experience-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
