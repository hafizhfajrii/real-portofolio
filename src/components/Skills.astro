---
import { content, skillCategoriesData } from '../data/portfolio';
const { skills } = content.id;
const enSkills = content.en.skills;
---

<section id="skills" class="skills-section section-primary transition-colors duration-300">
  <div class="container">
    <!-- Section Header -->
    <div class="section-header">
      <span class="section-tag" data-i18n-id={skills.sectionTag} data-i18n-en={enSkills.sectionTag}>
        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
        {skills.sectionTag}
      </span>
      <h2 class="section-title">
        <span data-i18n-id={skills.title} data-i18n-en={enSkills.title}>{skills.title}</span>{' '}
        <span class="gradient-text" data-i18n-id={skills.titleHighlight} data-i18n-en={enSkills.titleHighlight}>{skills.titleHighlight}</span>
      </h2>
      <p class="section-subtitle" data-i18n-id={skills.subtitle} data-i18n-en={enSkills.subtitle}>
        {skills.subtitle}
      </p>
    </div>

    <!-- Skills 3-Cards Matrix (Matching User Image 2 Template) -->
    <div class="skills-cards-grid">
      {skillCategoriesData.map((item) => (
        <div class="glass-card skill-card-item">
          <!-- Top Icon Box (Image 2 Style) -->
          <div class="skill-icon-box">
            {item.icon === 'ai' && (
              <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
                <rect x="9" y="9" width="6" height="6"></rect>
                <line x1="9" y1="1" x2="9" y2="4"></line>
                <line x1="15" y1="1" x2="15" y2="4"></line>
                <line x1="9" y1="20" x2="9" y2="23"></line>
                <line x1="15" y1="20" x2="15" y2="23"></line>
                <line x1="20" y1="9" x2="23" y2="9"></line>
                <line x1="20" y1="14" x2="23" y2="14"></line>
                <line x1="1" y1="9" x2="4" y2="9"></line>
                <line x1="1" y1="14" x2="4" y2="14"></line>
              </svg>
            )}
            {item.icon === 'data' && (
              <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
              </svg>
            )}
            {item.icon === 'code' && (
              <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            )}
          </div>

          <!-- Category Title (Image 2 Style) -->
          <h3 class="skill-card-title" data-i18n-id={item.category.id} data-i18n-en={item.category.en}>
            {item.category.id}
          </h3>

          <!-- Category Description (Image 2 Style) -->
          <p class="skill-card-desc" data-i18n-id={item.desc.id} data-i18n-en={item.desc.en}>
            {item.desc.id}
          </p>

          <!-- Pills Grid (Image 2 Style: Pills with colored dots) -->
          <div class="skill-pills-grid">
            {item.pills.map((pill) => (
              <div class="skill-pill-badge">
                <span class="pill-dot" style={`background-color: ${pill.dotColor}; box-shadow: 0 0 6px ${pill.dotColor};`}></span>
                <span class="pill-name">{pill.name}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-section {
    padding-top: 5.5rem;
    padding-bottom: 5.5rem;
    position: relative;
    z-index: 1;
  }

  .skills-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.85rem;
  }

  .skill-card-item {
    background: var(--bg-card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    transition: var(--transition-smooth);
    box-shadow: var(--shadow-glass);
  }

  .skill-card-item:hover {
    background: var(--bg-card-hover);
    border-color: rgba(192, 132, 252, 0.42);
    transform: translateY(-4px);
    box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.9), 0 0 22px rgba(147, 51, 234, 0.22);
  }

  :global(html[data-theme='light']) .skill-card-item {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
  }

  :global(html[data-theme='light']) .skill-card-item:hover {
    background: var(--bg-card-hover);
    border-color: rgba(124, 58, 237, 0.35);
    box-shadow: 0 14px 30px -4px rgba(0, 0, 0, 0.08), 0 0 20px rgba(124, 58, 237, 0.08);
  }

  /* Top Square Icon Box */
  .skill-icon-box {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(168, 85, 247, 0.2);
    color: var(--accent-purple-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.35rem;
    transition: var(--transition-smooth);
  }

  .skill-card-item:hover .skill-icon-box {
    background: linear-gradient(135deg, rgba(147, 51, 234, 0.25) 0%, rgba(126, 34, 206, 0.25) 100%);
    border-color: rgba(192, 132, 252, 0.5);
    color: #d8b4fe;
  }

  :global(html[data-theme='light']) .skill-icon-box {
    background: rgba(124, 58, 237, 0.08);
    border: 1px solid rgba(124, 58, 237, 0.22);
    color: #6d28d9;
  }

  :global(html[data-theme='light']) .skill-card-item:hover .skill-icon-box {
    background: #7c3aed;
    border-color: #6d28d9;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(124, 58, 237, 0.35);
  }

  /* Card Title */
  .skill-card-title {
    font-size: 1.28rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
    margin: 0;
  }

  :global(html[data-theme='light']) .skill-card-title {
    color: #18181b;
  }

  /* Card Description */
  .skill-card-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  :global(html[data-theme='light']) .skill-card-desc {
    color: #52525b;
  }

  /* Pills Grid (Image 2) */
  .skill-pills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .skill-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.42rem 0.95rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    transition: var(--transition-smooth);
  }

  .skill-pill-badge:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
  }

  :global(html[data-theme='light']) .skill-pill-badge {
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
  }

  :global(html[data-theme='light']) .skill-pill-badge:hover {
    background: rgba(124, 58, 237, 0.06);
    border-color: rgba(124, 58, 237, 0.25);
    transform: translateY(-2px);
  }

  .pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .pill-name {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  :global(html[data-theme='light']) .pill-name {
    color: #18181b;
  }

  @media (max-width: 992px) {
    .skills-cards-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .skills-section {
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
  }
</style>
